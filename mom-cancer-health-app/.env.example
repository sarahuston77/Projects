# Copy this file to `.env` (kept out of git) and fill in real values.
# The app reads these via os.environ in HealthApp.send_sms_via_email().

# Gmail address used as the SMTP sender for low-mood SMS alerts.
HEALTH_APP_EMAIL=your.address@gmail.com

# Gmail App Password (NOT your normal account password).
# Create one at: https://myaccount.google.com/apppasswords
HEALTH_APP_PASSWORD=your-16-char-app-password

# 10-digit caregiver phone number to notify on low-mood entries (digits only or formatted).
HEALTH_APP_CAREGIVER_PHONE=5555555555
